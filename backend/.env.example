# Máy dev (MySQL local hoặc Docker trên chính máy này):
DB_HOST=localhost
# Nhiều máy dùng chung MySQL trên một máy chủ LAN: đặt IP hoặc hostname máy chạy Docker/MySQL, ví dụ 192.168.1.50
# DB_HOST=192.168.1.50

DB_PORT=3306
DB_USER=root
# Trùng MYSQL_ROOT_PASSWORD trong .env của docker-compose (máy chạy container)
DB_PASSWORD=mentorai_local_dev
DB_NAME=mentoraigrad
PORT=5000

JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

